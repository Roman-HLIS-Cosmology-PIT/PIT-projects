{
  "lock": false,
  // Slack API 2.8.0 includes a legacy std/fs dependency with untyped catches.
  "compilerOptions": { "useUnknownInCatchVariables": false },
  "imports": {
    "deno-slack-sdk/": "https://deno.land/x/deno_slack_sdk@2.15.1/",
    "deno-slack-api/": "https://deno.land/x/deno_slack_api@2.8.0/"
  },
  "tasks": {
    "check": "deno check manifest.ts triggers/*.ts",
    "test": "deno test tests/*_test.ts"
  }
}
